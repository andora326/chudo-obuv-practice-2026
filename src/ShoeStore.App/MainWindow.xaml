<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShoeStore.App.MainWindow" Title="Чудо Обувь: каталог" Width="1000" Height="620" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="20,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Image x:Name="Logo" Width="74" Height="74" Stretch="Uniform" Margin="0,0,18,0" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Чудо Обувь" FontSize="22" FontWeight="Bold" />
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock x:Name="UserLabel" Text="Гость" HorizontalAlignment="Right" />
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="LoginBox" Width="160" ToolTip="Логин из списка пользователей" AutomationProperties.Name="Логин" KeyDown="LoginKeyDown" />
            <Button x:Name="LoginButton" Content="Войти" Click="LoginClick" />
            <Button x:Name="LogoutButton" Content="Выйти" Click="LogoutClick" Visibility="Collapsed" />
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8">
      <Button Content="Каталог" Click="CatalogClick" />
      <Button x:Name="CartButton" Content="Корзина (0)" Click="CartClick" Visibility="Collapsed" />
      <Button x:Name="OrdersButton" Content="Заказы" Click="OrdersClick" Visibility="Collapsed" />
    </StackPanel>
    <Border DockPanel.Dock="Bottom" Background="#D2F6E7" Padding="22,9">
      <TextBlock x:Name="StatusLabel" Text="Гостю доступен просмотр каталога. Для оформления заказа войдите по логину." TextWrapping="Wrap" />
    </Border>
    <Grid x:Name="PagesHost" Margin="22,0,22,12">
   </Grid>
  </DockPanel>
</Window>