<Window x:Class="ShoeStore.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Чудо Обувь: каталог" Width="1180" Height="800" MinWidth="940" MinHeight="620" WindowStartupLocation="CenterScreen">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#D2F6E7" Padding="20,12">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image x:Name="Logo" Width="74" Height="74" Stretch="Uniform" Margin="0,0,18,0"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="ЧУДО ОБУВЬ" FontSize="26" FontWeight="Bold"/><TextBlock Text="Выберите свою пару" Foreground="#315B57"/></StackPanel>
    <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="UserLabel" Text="Гость" HorizontalAlignment="Right"/><StackPanel Orientation="Horizontal"><TextBox x:Name="LoginBox" Width="160" ToolTip="Логин из списка пользователей" AutomationProperties.Name="Логин" KeyDown="LoginKeyDown"/><Button x:Name="LoginButton" Content="Войти" Click="LoginClick"/><Button x:Name="LogoutButton" Content="Выйти" Click="LogoutClick" Visibility="Collapsed"/></StackPanel></StackPanel>
   </Grid>
  </Border>
  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,8"><Button Content="Каталог" Click="CatalogClick"/><Button x:Name="CartButton" Content="Корзина (0)" Click="CartClick" Visibility="Collapsed"/><Button x:Name="OrdersButton" Content="Заказы" Click="OrdersClick" Visibility="Collapsed"/></StackPanel>
  <Border DockPanel.Dock="Bottom" Background="#D2F6E7" Padding="22,9"><TextBlock x:Name="StatusLabel" Text="Гостю доступен просмотр каталога. Для оформления заказа войдите по логину." TextWrapping="Wrap"/></Border>
  <Grid x:Name="PagesHost" Margin="22,0,22,12">
   <Grid x:Name="CatalogPanel">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
    <TextBlock Text="Каталог обуви" FontSize="28" FontWeight="Bold" Margin="4,5,0,12"/>
    <Grid x:Name="Filters" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="210"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><TextBox x:Name="SearchBox" AutomationProperties.Name="Поиск по названию и описанию" ToolTip="Поиск по названию и описанию" TextChanged="SearchChanged"/><ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="FilterChanged"/><ComboBox x:Name="SortBox" Grid.Column="2" SelectionChanged="FilterChanged"><ComboBoxItem Content="Без сортировки"/><ComboBoxItem Content="Цена по возрастанию"/><ComboBoxItem Content="Цена по убыванию"/></ComboBox></Grid>
    <Grid Grid.Row="2"><ListView x:Name="ProductList" BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch" MouseDoubleClick="ProductDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListView.ItemTemplate><DataTemplate><Border Padding="14" Margin="0,0,0,8" BorderBrush="#D2F6E7" BorderThickness="1"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="White"/><Style.Triggers><DataTrigger Binding="{Binding LowStock}" Value="True"><Setter Property="Background" Value="#FF8080"/></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><Image Source="{Binding ImagePath}" Width="130" Height="120" Stretch="Uniform"/><StackPanel Grid.Column="1" Margin="12,0"><TextBlock Text="{Binding Product.Category}" Foreground="#315B57"/><TextBlock Text="{Binding Product.Name}" FontWeight="Bold" FontSize="19" TextWrapping="Wrap"/><TextBlock Text="{Binding Product.Manufacturer,StringFormat=Производство: {0}}" Margin="0,4"/><TextBlock Text="{Binding Product.Composition}" TextWrapping="Wrap" FontSize="14"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Product.OldPriceLabel}" TextDecorations="Strikethrough" Foreground="#666666"/><TextBlock Text="{Binding Product.PriceLabel}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Product.QuantityLabel}" Margin="0,6"/><Button Content="Подробнее →" Click="DetailsClick" Tag="{Binding Product}"/></StackPanel></Grid></Border></DataTemplate></ListView.ItemTemplate>
    </ListView><TextBlock x:Name="EmptyCatalog" Text="Товары не найдены. Измените поиск или категорию." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
   </Grid>
   <Grid x:Name="CartPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Ваш заказ" FontSize="28" FontWeight="Bold" Margin="4,5,0,12"/><StackPanel x:Name="CustomerPanel" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed"><TextBlock Text="Клиент:" VerticalAlignment="Center"/><ComboBox x:Name="CustomerBox" Width="420" DisplayMemberPath="FullName"/></StackPanel><DataGrid x:Name="CartGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80"/><DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="70"/><DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total,StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="3"><StackPanel Orientation="Horizontal"><TextBlock Text="Количество выбранной позиции:" VerticalAlignment="Center"/><TextBox x:Name="CartQuantity" Width="70" Text="1" AutomationProperties.Name="Количество в корзине"/><Button Content="Изменить" Click="UpdateCartClick"/><Button Content="Удалить позицию" Click="RemoveCartClick"/><Button Content="Отменить заказ" Click="ClearCartClick"/></StackPanel><DockPanel><TextBlock x:Name="CartTotal" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/><Button Content="Подтвердить заказ" Background="#70B2AF" HorizontalAlignment="Right" Click="ConfirmOrderClick"/></DockPanel></StackPanel></Grid>
   <Grid x:Name="OrdersPanel" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock Text="Заказы клиентов" FontSize="28" FontWeight="Bold"/><Button Content="Новый заказ" Click="NewOrderClick" HorizontalAlignment="Right"/></DockPanel><DataGrid x:Name="OrdersGrid" Grid.Row="1" SelectionChanged="OrderSelectionChanged"><DataGrid.Columns><DataGridTextColumn Header="Номер" Binding="{Binding Id}" Width="80"/><DataGridTextColumn Header="Дата" Binding="{Binding OrderedAt,StringFormat=dd.MM.yyyy}" Width="140"/><DataGridTextColumn Header="Клиент" Binding="{Binding Customer}" Width="*"/><DataGridTextColumn Header="Итого, ₽" Binding="{Binding Total,StringFormat=N2}" Width="160"/></DataGrid.Columns></DataGrid><TextBlock Grid.Row="2" Text="Состав выбранного заказа" FontSize="21" Margin="4,12"/><DataGrid x:Name="OrderLinesGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="Модель" Binding="{Binding Product}" Width="*"/><DataGridTextColumn Header="Производство" Binding="{Binding Manufacturer}" Width="170"/><DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="75"/><DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="60"/><DataGridTextColumn Header="Цена, ₽" Binding="{Binding UnitPrice,StringFormat=N2}" Width="110"/><DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total,StringFormat=N2}" Width="120"/></DataGrid.Columns></DataGrid><StackPanel Grid.Row="4" Orientation="Horizontal"><Button Content="Удалить заказ" Click="DeleteOrderClick"/><StackPanel x:Name="AdminControls" Orientation="Horizontal" Visibility="Collapsed"><DatePicker x:Name="OrderDate" Width="160" VerticalAlignment="Center" Margin="12,4"/><Button Content="Изменить дату" Click="ChangeDateClick"/><Button Content="Удалить позицию" Click="DeleteLineClick"/></StackPanel></StackPanel></Grid>
  </Grid>
 </DockPanel>
</Window>
