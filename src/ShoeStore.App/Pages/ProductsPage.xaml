<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShoeStore.App.Pages.ProductsPage" Title="Каталог обуви" Language="ru-RU" FontFamily="Calibri" FontSize="16" Background="White">
  <Grid x:Name="CatalogPanel" Visibility="Visible">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
    </Grid.RowDefinitions>
    <TextBlock Text="Каталог обуви" FontSize="28" FontWeight="Bold" Margin="4,5,0,12" />
    <Grid x:Name="Filters" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition />
        <ColumnDefinition Width="210" />
        <ColumnDefinition Width="240" />
      </Grid.ColumnDefinitions>
      <TextBox x:Name="SearchBox" AutomationProperties.Name="Поиск по названию и описанию" ToolTip="Поиск по названию и описанию" TextChanged="SearchChanged" />
      <ComboBox x:Name="CategoryBox" Grid.Column="1" SelectionChanged="FilterChanged" />
      <ComboBox x:Name="SortBox" Grid.Column="2" SelectionChanged="FilterChanged">
        <ComboBoxItem Content="Без сортировки" />
        <ComboBoxItem Content="Цена по возрастанию" />
        <ComboBoxItem Content="Цена по убыванию" />
      </ComboBox>
    </Grid>
    <Grid Grid.Row="2">
      <ListView x:Name="ProductList" BorderThickness="0" Background="White" HorizontalContentAlignment="Stretch" MouseDoubleClick="ProductDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Border Padding="14" Margin="0,0,0,8" BorderBrush="#D2F6E7" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="White" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding LowStock}" Value="True">
                      <Setter Property="Background" Value="#FF8080" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="150" />
                  <ColumnDefinition />
                  <ColumnDefinition Width="190" />
                </Grid.ColumnDefinitions>
                <Image Source="{Binding ImagePath}" Width="130" Height="120" Stretch="Uniform" />
                <StackPanel Grid.Column="1" Margin="12,0">
                  <TextBlock Text="{Binding Product.Category}" Foreground="#315B57" />
                  <TextBlock Text="{Binding Product.Name}" FontWeight="Bold" FontSize="19" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Product.Manufacturer,StringFormat=Производство: {0}}" Margin="0,4" />
                  <TextBlock Text="{Binding Product.Composition}" TextWrapping="Wrap" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Product.OldPriceLabel}" TextDecorations="Strikethrough" Foreground="#666666" />
                  <TextBlock Text="{Binding Product.PriceLabel}" FontSize="18" FontWeight="Bold" TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Product.QuantityLabel}" Margin="0,6" />
                  <Button Content="Подробнее →" Click="DetailsClick" Tag="{Binding Product}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
      <TextBlock x:Name="EmptyCatalog" Text="Товары не найдены. Измените поиск или категорию." Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
  </Grid>
</Page>