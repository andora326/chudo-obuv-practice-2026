<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="ShoeStore.App.Pages.CartPage" Title="Оформление заказа" FontFamily="Calibri" FontSize="16" Background="White">
  <Grid x:Name="CartPanel" Visibility="Visible">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Text="Ваш заказ" FontSize="28" FontWeight="Bold" Margin="4,5,0,12" />
    <StackPanel x:Name="CustomerPanel" Grid.Row="1" Orientation="Horizontal" Visibility="Collapsed">
      <TextBlock Text="Клиент:" VerticalAlignment="Center" />
      <ComboBox x:Name="CustomerBox" Width="420" DisplayMemberPath="FullName" />
    </StackPanel>
    <DataGrid x:Name="CartGrid" Grid.Row="2">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Наименование" Binding="{Binding Name}" Width="*" />
        <DataGridTextColumn Header="Размер" Binding="{Binding Size}" Width="80" />
        <DataGridTextColumn Header="Пар" Binding="{Binding Quantity}" Width="70" />
        <DataGridTextColumn Header="Цена, ₽" Binding="{Binding Price,StringFormat=N2}" Width="110" />
        <DataGridTextColumn Header="Сумма, ₽" Binding="{Binding Total,StringFormat=N2}" Width="120" />
      </DataGrid.Columns>
    </DataGrid>
    <StackPanel Grid.Row="3">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Количество выбранной позиции:" VerticalAlignment="Center" />
        <TextBox x:Name="CartQuantity" Width="70" Text="1" AutomationProperties.Name="Количество в корзине" />
        <Button Content="Изменить" Click="UpdateCartClick" />
        <Button Content="Удалить позицию" Click="RemoveCartClick" />
        <Button Content="Отменить заказ" Click="ClearCartClick" />
      </StackPanel>
      <DockPanel>
        <TextBlock x:Name="CartTotal" FontSize="24" FontWeight="Bold" VerticalAlignment="Center" />
        <Button Content="Подтвердить заказ" Background="#70B2AF" HorizontalAlignment="Right" Click="ConfirmOrderClick" />
      </DockPanel>
    </StackPanel>
  </Grid>
</Page>