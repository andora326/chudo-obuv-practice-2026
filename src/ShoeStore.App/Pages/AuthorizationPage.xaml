<Page x:Class="ShoeStore.App.Pages.AuthorizationPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Авторизация" Language="ru-RU" FontFamily="Arial" FontSize="10" Width="984" Background="White">
  <Grid>
    <StackPanel Width="310" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image x:Name="AuthLogo" Width="72" Height="56" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,0,0,10" />
      <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,16" />
      <TextBlock Text="Логин:" FontSize="12" Margin="0,0,0,3" />
      <TextBox x:Name="LoginField" Height="29" Margin="0,0,0,8" Padding="6,3" FontSize="13" ToolTip="Логин" AutomationProperties.Name="Логин пользователя" KeyDown="LoginKeyDown" />
      <Button Content="Войти" Height="30" Margin="0,0,0,8" Padding="5,2" FontSize="12" Click="LoginClick" Background="#D2F6E7" BorderBrush="#70B2AF" />
      <Button Content="Войти как гость" Height="30" Margin="0" Padding="5,2" FontSize="12" Click="GuestClick" Background="#D5D5D5" BorderBrush="#A0A0A0" />
    </StackPanel>
  </Grid>
</Page>
